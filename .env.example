# Copy these placeholder names into Render's Environment settings and replace
# every value with your own credentials. This file is documentation only.

APP_ENV=production
# Leave empty on Render (root URL). XAMPP subfolder paths are detected locally.
APP_BASE_PATH=

# Supabase Database > Connect. Prefer Session pooler (port 5432) if the direct
# endpoint is not reachable from your hosting network. Keep SSL enabled.
DB_HOST=your-supabase-session-pooler-host
DB_PORT=5432
DB_NAME=postgres
DB_USER=your-supabase-database-user
DB_PASS=replace-with-your-database-password

AUTH_ADMIN_USERNAME=your-administrator-username
AUTH_ADMIN_ROLE=Administrator
AUTH_ADMIN_PASSWORD_HASH=replace-with-base64-encoded-password-hash
AUTH_STAFF_USERNAME=your-staff-username
AUTH_STAFF_ROLE=Staff
AUTH_STAFF_PASSWORD_HASH=replace-with-base64-encoded-password-hash

# Optional local XAMPP fallback only: point to the existing protected INI file
# outside the web root. Do not set this on Render.
# AP3_LEGACY_CONFIG_FILE=/path/to/private/ap3_project.ini
